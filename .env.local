# ---------------------------------------------------------------------------
# 1000% LOCAL environment -- used by docker-compose.local.yml only.
# No Supabase, no AWS, no external infra. Postgres, MinIO (S3) and Redis all
# run as containers. Only the vendor API keys below are optional external
# calls (FRED/OpenFIGI); ingestion works without them for Yahoo/SEC.
#
#   docker compose -f docker-compose.local.yml --env-file .env.local up -d --build
# ---------------------------------------------------------------------------

# "docker" != "local" so the API key guard stays active in-container. Set to
# "local" instead if you want to hit the API with no X-API-Key header at all.
ENV=docker

# --- Postgres (serving layer, local container) ------------------------------
DATABASE_URL=postgresql+psycopg2://finance:finance@postgres:5432/finance

# --- MinIO (local S3-compatible data lake: bronze/silver/gold) --------------
BUCKET_ID=finance-data-lake
S3_ENDPOINT_URL=http://minio:9000
ACCESS_KEY_ID=minioadmin
SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# --- Vendor API keys (optional -- leave blank to skip those sources) --------
FRED_API_KEY=124c1deffcfc0ac262438370ed661488
OPENFIGI_API_KEY=a54b6508-acdb-460c-9ee8-9ae54f55d80e

# --- API auth ---------------------------------------------------------------
# Shared secret enforced because ENV=docker. Send it as the X-API-Key header.
API_KEY=local-dev-key
CORS_ORIGINS=*

# --- Redis cache (local container) ------------------------------------------
REDIS_URL=redis://redis:6379/0
